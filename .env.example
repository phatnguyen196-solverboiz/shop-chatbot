# Sao chép file này thành ".env" rồi điền key của bạn.
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên model Gemini. Nếu báo lỗi 404, hãy đổi sang model mới hơn trong danh sách của Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Cổng chạy server
PORT=3000

# Các web được phép nhúng chatbot (cách nhau bằng dấu phẩy). Dùng * khi thử nghiệm.
# Khi chạy thật nên ghi rõ, ví dụ: https://shopcuaban.com,https://www.shopcuaban.com
ALLOWED_ORIGINS=*

# Giới hạn yêu cầu chat mỗi phút theo IP (lưu trong bộ nhớ tiến trình)
RATE_LIMIT_PER_MIN=20

# Chỉ bật khi server đứng sau reverse proxy đáng tin cậy
TRUST_PROXY=false

# Tùy chọn cho model Gemini hỗ trợ thinking budget; để trống để dùng mặc định
GEMINI_THINKING_BUDGET=
